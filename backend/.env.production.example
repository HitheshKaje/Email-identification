# JobMail Production Environment Template (No localhost URLs or placeholders allowed at runtime)
# Supply real values via your managed secret manager (GCP Secret Manager / AWS Secrets Manager / Vault).

APP_NAME="JobMail API"
ENVIRONMENT="production"
DEBUG="false"
HOST="0.0.0.0"
PORT="8000"

# MongoDB Atlas / Managed MongoDB with TLS + Least-Privilege Credentials
MONGODB_URI="mongodb+srv://your_db_user:your_db_password@cluster.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="jobmail_prod"
MONGODB_TLS_CA_FILE=""
MONGODB_MAX_POOL_SIZE="50"
MONGODB_MIN_POOL_SIZE="2"

# Strong Secrets (>=32 char JWT secret; valid MultiFernet key(s))
JWT_SECRET_KEY="replace-via-secret-manager"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="14"
TOKEN_ENCRYPTION_KEY="replace-via-secret-manager"
TOKEN_ENCRYPTION_KEYS=""

MFA_ISSUER="JobMail"
MAX_FAILED_LOGIN_ATTEMPTS="5"
ACCOUNT_LOCKOUT_MINUTES="15"
REQUIRE_EMAIL_VERIFICATION="true"

# Public Domain, HTTPS Cookies, Strict CORS & Trusted Hosts (NO localhost)
FRONTEND_URL="https://app.yourdomain.com"
CORS_ORIGINS="https://app.yourdomain.com"
TRUSTED_HOSTS="api.yourdomain.com"
COOKIE_SECURE="true"
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=".yourdomain.com"
ENABLE_API_DOCS="false"

# Shared Rate Limiting & Abuse Controls
RATE_LIMIT_ENABLED="true"
REDIS_URL=""
MAX_REQUEST_BODY_BYTES="1048576"
SYNC_COOLDOWN_SECONDS="30"
DEFAULT_DATA_RETENTION_DAYS="180"

# Google OAuth 2.0 (HTTPS callback required)
GOOGLE_CLIENT_ID="your_prod_google_client_id"
GOOGLE_CLIENT_SECRET="your_prod_google_client_secret"
GOOGLE_REDIRECT_URI="https://api.yourdomain.com/auth/google/callback"
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.readonly"
OAUTH_STATE_EXPIRE_MINUTES="10"
GMAIL_SYNC_MAX_MESSAGES="100"
GMAIL_SYNC_PAGE_SIZE="25"
AUTO_SYNC_ENABLED="true"
AUTO_SYNC_INTERVAL_SECONDS="900"

# Outbound Transactional Email (SMTP)
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT="587"
SMTP_USERNAME="your_smtp_user"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_USE_TLS="true"

# Firebase Cloud Messaging (Optional)
FIREBASE_CREDENTIALS_PATH="/run/secrets/firebase-adminsdk.json"
