# JobMail Backend Configuration Template (Development)
# Copy this file to backend/.env and fill in strong, unique values before running in production.
# Never commit backend/.env or real credentials to version control.

APP_NAME="JobMail API"
ENVIRONMENT="development"
DEBUG="false"
HOST="0.0.0.0"
PORT="8000"

# MongoDB Database (local URI or authenticated cloud URI)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="jobmail"
MONGODB_TLS_CA_FILE=""

# Security, Argon2id, Sessions & MultiFernet Key Rotation
# Generate JWT secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="replace-with-strong-random-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="14"

# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY="replace-with-fernet-base64-key"
# Optional comma-separated keys for key rotation: "<new_key>,<old_key>"
TOKEN_ENCRYPTION_KEYS=""

MFA_ISSUER="JobMail"
MAX_FAILED_LOGIN_ATTEMPTS="5"
ACCOUNT_LOCKOUT_MINUTES="15"

# Cookies, Frontend & CORS
FRONTEND_URL="http://localhost:8080"
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
RATE_LIMIT_ENABLED="true"
DEFAULT_DATA_RETENTION_DAYS="180"

# Google OAuth 2.0 (Phase 3)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.readonly"
OAUTH_STATE_EXPIRE_MINUTES="10"
GMAIL_SYNC_MAX_MESSAGES="100"
GMAIL_SYNC_PAGE_SIZE="25"
AUTO_SYNC_ENABLED="true"
AUTO_SYNC_INTERVAL_SECONDS="900"

# Outbound SMTP (Email verification & password reset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"

# Firebase Cloud Messaging (optional local path to service account JSON)
FIREBASE_CREDENTIALS_PATH=""
